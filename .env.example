DATABASE_URL=postgresql://ad_demo:replace-with-local-password@127.0.0.1:55432/ad_demo
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://127.0.0.1:3000
DEMO_MODE=true
DEMO_SEED_PASSWORD=replace-with-a-demo-only-password
PAYMENT_PROVIDER=mock-mpesa
PAYMENT_CALLBACK_SECRET=replace-with-at-least-32-random-characters
STORE_CURRENCY=LSL
STORAGE_PROVIDER=local
STORAGE_ROOT=private-storage
# Vercel: set STORAGE_PROVIDER=vercel-blob and connect a PRIVATE Blob store.
# Cloud credentials belong in Vercel environment variables, never Git.
BLOB_READ_WRITE_TOKEN=
# No M-Pesa endpoints or credentials are assumed. Add authorised provider-specific
# settings only after obtaining that provider's actual documentation.
